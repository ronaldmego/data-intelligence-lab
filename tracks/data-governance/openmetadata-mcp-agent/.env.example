# OpenMetadata Agent - Configuración
# Copiar este archivo a .env y completar con tus credenciales

# API Key de Gemini (recomendado: cuenta pagada)
GOOGLE_API_KEY=tu-api-key-de-gemini

# URL de tu instancia de OpenMetadata (remota o local)
# Ejemplo remoto: http://10.0.0.50:8585
# Ejemplo local:  http://localhost:8585
OPENMETADATA_URL=http://tu-servidor:8585

# Token JWT de OpenMetadata (obtener desde Settings > Bots)
OPENMETADATA_TOKEN=tu-jwt-token

# Modelo de Gemini a usar (opciones: gemini-2.5-pro, gemini-2.5-flash, gemini-3-pro-preview)
GEMINI_MODEL=gemini-2.5-pro
