# OpenMetadata Agent - Configuration
# Copy this file to .env and fill in your credentials

# Gemini API key (get one at https://aistudio.google.com/apikey)
GOOGLE_API_KEY=your-gemini-api-key

# OpenMetadata instance URL (remote or local)
# Remote example: http://10.0.0.50:8585
# Local example:  http://localhost:8585
OPENMETADATA_URL=http://your-server:8585

# OpenMetadata JWT token (get it from Settings > Bots in your OpenMetadata UI)
OPENMETADATA_TOKEN=your-jwt-token

# Gemini model to use (options: gemini-2.5-pro, gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-pro
