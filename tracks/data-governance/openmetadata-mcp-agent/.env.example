# OpenMetadata Agent - Configuration
# Copy this file to .env and fill in your credentials

# Gemini API key (get one at https://aistudio.google.com/apikey)
GOOGLE_API_KEY=your-gemini-api-key

# OpenMetadata instance URL
# Option A - Direct IP (simplest, no SSL issues):
#   OPENMETADATA_URL=http://your-server:8585
# Option B - DNS with HTTPS (if your instance has a domain + SSL):
#   OPENMETADATA_URL=https://openmetadata.example.com
# Option C - Local development:
#   OPENMETADATA_URL=http://localhost:8585
#
# NOTE: If using HTTPS with a self-signed or corporate certificate,
# set OPENMETADATA_VERIFY_SSL=false below.
OPENMETADATA_URL=http://your-server:8585

# SSL certificate verification (only relevant for HTTPS URLs)
# Set to "false" if using self-signed or corporate certificates
# Default: true
# OPENMETADATA_VERIFY_SSL=false

# OpenMetadata JWT token (get it from Settings > Bots > MCP Application)
OPENMETADATA_TOKEN=your-jwt-token

# Gemini model to use (options: gemini-2.5-pro, gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-pro
