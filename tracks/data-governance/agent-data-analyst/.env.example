# Khipu Enterprise Configuration

# OpenMetadata
OPENMETADATA_HOST=http://localhost:8585
OPENMETADATA_JWT_TOKEN=  # Optional: for authenticated access

# OpenAI (for LangChain)
OPENAI_API_KEY=sk-...

# Database connections (for direct queries)
# Oracle
ORACLE_DSN=
ORACLE_USER=
ORACLE_PASSWORD=

# BigQuery
GOOGLE_APPLICATION_CREDENTIALS=/path/to/credentials.json
BIGQUERY_PROJECT=

# PostgreSQL (local dev)
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=khipu

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true
