# Copiar a .env y completar. Nunca se versionan valores reales.

# --- OpenMetadata (solo lectura) ---
OPENMETADATA_URL=http://localhost:8585
OPENMETADATA_EMAIL=admin@open-metadata.org
OPENMETADATA_PASSWORD=admin
# Alternativa al par email/password. Ojo: si está definido tiene precedencia,
# así que un token viejo de otra instancia hace fallar todo con 401. El cliente
# lo comprueba y cae a email/password si no sirve.
# OPENMETADATA_TOKEN=

# --- PostgreSQL con Pagila ---
# Usar un rol de SOLO LECTURA. El POC además abre transacción READ ONLY, pero
# el rol es la capa que queda si todo lo demás falla.
PAGILA_HOST=localhost
PAGILA_PORT=5432
PAGILA_USER=pagila_curso
PAGILA_PASSWORD=
PAGILA_DB=pagila

# --- Modelo, sólo para `--mode llm` ---
KIMI_API_KEY=
KIMI_MODEL=kimi-k2.6
LLM_BASE_URL=https://api.moonshot.ai/v1
# Los modelos Kimi más nuevos rechazan temperature 0; dejar sin definir.
# LLM_TEMPERATURE=
